---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Why from '../components/Why.astro';
import Workflow from '../components/Workflow.astro';
import Playground from '../components/Playground.astro';
import Ecosystem from '../components/Ecosystem.astro';
import Foundations from '../components/Foundations.astro';
import Faq from '../components/Faq.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';

const title = 'Acadlas School: school management software, in development';
const description =
  'Acadlas School is school management software in development. It brings admissions, classes, attendance and fees into one connected record for every student.';
---

<Layout title={title} description={description}>
  <Header />
  <main id="main">
    <Hero />
    <Why />
    <Workflow />
    <Playground />
    <Ecosystem />
    <Foundations />
    <Faq />
    <Closing />
  </main>
  <Footer />
</Layout>
