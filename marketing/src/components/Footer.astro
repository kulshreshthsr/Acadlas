---
import { Image } from 'astro:assets';
import wordmark from '../assets/brand/acadlas-wordmark-light.png';
import { navLinks, contactEmail } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-night text-slate-400" data-surface="dark">
  <div class="wrap flex flex-col gap-6 py-10 md:flex-row md:items-center md:justify-between">
    <a href="#top" aria-label="Acadlas, back to top" class="inline-flex min-h-11 items-center self-start rounded-sm">
      <Image src={wordmark} alt="Acadlas" width={120} height={25} format="png" densities={[1.5, 2]} class="h-6 w-auto" />
    </a>

    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-6">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="inline-flex min-h-11 items-center text-[0.9375rem] font-medium text-slate-300 transition-colors hover:text-white">
                {link.label}
              </a>
            </li>
          ))
        }
        {
          contactEmail && (
            <li>
              <a href={`mailto:${contactEmail}`} class="inline-flex min-h-11 items-center text-[0.9375rem] font-medium text-slate-300 transition-colors hover:text-white">
                Contact
              </a>
            </li>
          )
        }
      </ul>
    </nav>
  </div>

  <div class="border-t border-white/5">
    <div class="wrap flex flex-col gap-1 py-5 text-[0.8125rem] sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Acadlas</p>
      <p>Acadlas School is in development. This page describes intended scope, not available features.</p>
    </div>
  </div>
</footer>
