---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { contactEmail } from '../data/site';

interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<Layout title={`${title} | Acadlas`} description={description}>
  <Header />
  <main id="main" class="bg-paper pb-24 pt-32 sm:pt-40">
    <div class="wrap max-w-[46rem]">
      <p class="kicker">Legal</p>
      <h1 class="mt-5 text-[clamp(2rem,1.4rem+2.5vw,3.25rem)]">{title}</h1>
      <p class="mt-3 text-sm text-slate-600">Last updated {updated}</p>
      <div class="legal mt-10 space-y-5 text-[1.0625rem] leading-relaxed">
        <slot />
        {
          contactEmail && (
            <p>
              Questions: <a href={`mailto:${contactEmail}`} class="underline">{contactEmail}</a>
            </p>
          )
        }
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style is:global>
  .legal h2 {
    margin-top: 2.25rem;
    font-size: 1.375rem;
  }
  .legal ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .legal li + li {
    margin-top: 0.4rem;
  }
</style>
