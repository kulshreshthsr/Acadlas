---
// The Acadlas product map. Only Acadlas School is being built; the rest show intended direction.
type Status = 'now' | 'planned' | 'exploring';
type Product = { key: string; name: string; status: Status; body: string; ring: 0 | 1 | 2; angle: number };

const statusLabel: Record<Status, string> = {
  now: 'Building now',
  planned: 'Planned next',
  exploring: 'Being explored',
};

const outer = [
  ['crm', 'CRM', 'Leads, enquiries, relationships and follow-ups, usable on its own.'],
  ['billing', 'Billing', 'General billing and invoicing for any kind of institution.'],
  ['learn', 'Learn', 'Courses and learning management.'],
  ['assess', 'Assess', 'Tests, examinations and results.'],
  ['people', 'People', 'Staff, HR and related workflows.'],
  ['connect', 'Connect', 'Communication and notifications for staff and families.'],
  ['insights', 'Insights', 'Reporting and analytics across the products you use.'],
  ['flow', 'Flow', 'Forms, approvals and workflow automation.'],
] as const;

const products: Product[] = [
  {
    key: 'school',
    name: 'Acadlas School',
    status: 'now',
    body: 'Admissions, classes, attendance, fees, staff and reports for schools. Our first product, in development today.',
    ring: 0,
    angle: 0,
  },
  {
    key: 'institute',
    name: 'Acadlas Institute',
    status: 'planned',
    body: 'For coaching centres and institutes, with batches, courses, enquiries, counselling, tests and fee plans.',
    ring: 1,
    angle: 232,
  },
  {
    key: 'campus',
    name: 'Acadlas Campus',
    status: 'planned',
    body: 'For colleges and universities, with departments, programmes, semesters and faculty.',
    ring: 1,
    angle: 308,
  },
  ...outer.map(([key, name, body], i) => ({
    key,
    name: `Acadlas ${name}`,
    status: 'exploring' as Status,
    body,
    ring: 2 as const,
    angle: 10 + i * 45,
  })),
];

const radius = [0, 0.25, 0.42];
const at = (p: Product) => {
  const a = (p.angle * Math.PI) / 180;
  return { x: 50 + Math.cos(a) * radius[p.ring] * 100, y: 50 + Math.sin(a) * radius[p.ring] * 100 };
};
const school = products[0];
---

<section id="ecosystem" aria-labelledby="eco-title" data-surface="dark" class="section relative overflow-hidden bg-ink-950" data-eco>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(45%_50%_at_70%_50%,rgb(31_111_178/0.22),transparent_70%)]"></div>

  <div class="wrap relative grid items-center gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-16">
    <div>
      <p class="kicker">The Acadlas ecosystem</p>
      <h2 id="eco-title" class="mt-5">Start with School. Add more when you need it.</h2>
      <p class="lead mt-6 max-w-[32rem] text-slate-300">
        Acadlas is planned as a family of education products. Each one works on its own; connect them and they
        share sign-in and records, so nothing is set up twice.
      </p>

      <!-- Detail for the selected product. -->
      <div class="mt-9 rounded-[var(--radius-lg)] border border-white/10 bg-white/[0.04] p-5 backdrop-blur" aria-live="polite" data-eco-detail>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <p class="text-xl font-bold text-white [font-stretch:115%]" data-eco-name>{school.name}</p>
          <span class="eco-pill" data-status={school.status} data-eco-status>{statusLabel[school.status]}</span>
        </div>
        <p class="mt-2 text-slate-300" data-eco-body>{school.body}</p>
      </div>

      <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-300" aria-label="Map key">
        <li class="flex items-center gap-2"><span class="size-3 rounded-full bg-marigold-500"></span>Building now</li>
        <li class="flex items-center gap-2"><span class="size-3 rounded-full border-2 border-lagoon-300"></span>Planned next</li>
        <li class="flex items-center gap-2"><span class="size-3 rounded-full border-2 border-dashed border-slate-400"></span>Being explored</li>
      </ul>
      <p class="mt-4 max-w-[32rem] text-sm text-slate-400">
        Only Acadlas School is in development. The rest of the map shows where we intend to go, not products you can
        use today.
      </p>
    </div>

    <div class="relative mx-auto aspect-square w-full max-w-[36rem]" data-eco-map>
      <svg viewBox="0 0 100 100" class="absolute inset-0 size-full overflow-visible" aria-hidden="true">
        <circle cx="50" cy="50" r={radius[2] * 100} fill="none" stroke="rgb(154 170 191 / 0.28)" stroke-width="0.25" stroke-dasharray="0.8 1.2" data-eco-ring></circle>
        <circle cx="50" cy="50" r={radius[1] * 100} fill="none" stroke="rgb(111 207 204 / 0.35)" stroke-width="0.25"></circle>
        <circle cx="50" cy="50" r="10" fill="rgb(244 166 42 / 0.08)"></circle>
        {
          products
            .filter((p) => p.ring === 1)
            .map((p) => {
              const pt = at(p);
              return <line x1="50" y1="50" x2={pt.x} y2={pt.y} stroke="rgb(111 207 204 / 0.5)" stroke-width="0.3" />;
            })
        }
      </svg>

      {
        products.map((p) => {
          const pt = at(p);
          return (
            <button
              type="button"
              class="eco-node"
              data-status={p.status}
              data-ring={p.ring}
              data-angle={p.angle}
              data-key={p.key}
              data-name={p.name}
              data-body={p.body}
              data-label={statusLabel[p.status]}
              aria-pressed={p.key === 'school' ? 'true' : 'false'}
              style={`left:${pt.x}%;top:${pt.y}%`}
            >
              {p.ring === 0 ? (
                <span class="flex flex-col items-center leading-tight">
                  <span class="text-[0.6875rem] font-semibold opacity-70">Acadlas</span>
                  <span>School</span>
                </span>
              ) : (
                p.name.replace('Acadlas ', '')
              )}
            </button>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  // Selecting a product shows its detail; the outer ring turns slowly until the visitor engages with it.
  const root = document.querySelector<HTMLElement>('[data-eco]');
  if (root) {
    const map = root.querySelector<HTMLElement>('[data-eco-map]')!;
    const nodes = [...root.querySelectorAll<HTMLButtonElement>('.eco-node')];
    const nameEl = root.querySelector<HTMLElement>('[data-eco-name]')!;
    const bodyEl = root.querySelector<HTMLElement>('[data-eco-body]')!;
    const statusEl = root.querySelector<HTMLElement>('[data-eco-status]')!;

    const select = (node: HTMLButtonElement) => {
      nodes.forEach((n) => n.setAttribute('aria-pressed', String(n === node)));
      nameEl.textContent = node.dataset.name ?? '';
      bodyEl.textContent = node.dataset.body ?? '';
      statusEl.textContent = node.dataset.label ?? '';
      statusEl.dataset.status = node.dataset.status;
    };

    nodes.forEach((node) => {
      node.addEventListener('click', () => select(node));
      node.addEventListener('mouseenter', () => select(node));
      node.addEventListener('focus', () => select(node));
    });

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduceMotion) {
      const outer = nodes.filter((n) => n.dataset.ring === '2');
      let paused = false;
      let visible = false;
      let offset = 0;
      let last = performance.now();
      const R = 42;

      map.addEventListener('pointerenter', () => (paused = true));
      map.addEventListener('pointerleave', () => (paused = false));
      map.addEventListener('focusin', () => (paused = true));
      map.addEventListener('focusout', () => (paused = false));
      new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(map);

      const frame = (now: number) => {
        const dt = Math.min(now - last, 50);
        last = now;
        if (!paused && visible && !document.hidden) {
          offset += dt * 0.0022;
          outer.forEach((n) => {
            const a = ((Number(n.dataset.angle) + offset) * Math.PI) / 180;
            n.style.left = `${50 + Math.cos(a) * R}%`;
            n.style.top = `${50 + Math.sin(a) * R}%`;
          });
        }
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    }
  }
</script>
