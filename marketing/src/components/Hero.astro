---
import Icon from './Icon.astro';
import type { IconName } from '../data/icons';

// Illustrative sample record. Positions are fractions of the stage: x/y on wide screens, mx/my on phones.
type Satellite = {
  key: string;
  icon: IconName;
  label: string;
  values: string[];
  detail: [string, string][];
  x: number;
  y: number;
  mx: number;
  my: number;
  depth: number;
};

const satellites: Satellite[] = [
  {
    key: 'guardian',
    icon: 'guardian',
    label: 'Guardian',
    values: ['Neha Sharma, mother'],
    detail: [
      ['Phone', '+91 98xxx xx210'],
      ['Also guardian of', 'Riya, Class 2-A'],
    ],
    x: 0.2,
    y: 0.15,
    mx: 0.27,
    my: 0.09,
    depth: 1.3,
  },
  {
    key: 'class',
    icon: 'classes',
    label: 'Class',
    values: ['6-B, roll no. 23'],
    detail: [
      ['Class teacher', 'Ms. Kavita Iyer'],
      ['Academic year', '2026–27'],
    ],
    x: 0.83,
    y: 0.2,
    mx: 0.74,
    my: 0.25,
    depth: 0.9,
  },
  {
    key: 'attendance',
    icon: 'attendance',
    label: 'Attendance',
    values: ['96% this term', 'Present today, 8:42 am'],
    detail: [
      ['Absent this term', '3 days'],
      ['Last absent', '12 September'],
    ],
    x: 0.86,
    y: 0.67,
    mx: 0.73,
    my: 0.76,
    depth: 1.2,
  },
  {
    key: 'fees',
    icon: 'fees',
    label: 'Fees',
    values: ['Term 2: ₹6,500 due', 'Term 2: marked as paid'],
    detail: [
      ['Fee plan', 'Class 6, quarterly'],
      ['Paid this year', '₹13,000 of ₹26,000'],
    ],
    x: 0.55,
    y: 0.9,
    mx: 0.32,
    my: 0.92,
    depth: 0.8,
  },
  {
    key: 'admission',
    icon: 'admission',
    label: 'Admission',
    values: ['Admitted 2 April 2026'],
    detail: [
      ['Admission no.', '2026/0418'],
      ['Documents', '4 of 4 received'],
    ],
    x: 0.15,
    y: 0.68,
    mx: 0.25,
    my: 0.66,
    depth: 1.1,
  },
];

const scope: { icon: IconName; label: string }[] = [
  { icon: 'admission', label: 'Admissions' },
  { icon: 'classes', label: 'Classes and sections' },
  { icon: 'attendance', label: 'Attendance' },
  { icon: 'fees', label: 'Fees' },
  { icon: 'staff', label: 'Staff and roles' },
  { icon: 'reports', label: 'Reports' },
];
---

<section
  id="top"
  aria-labelledby="hero-title"
  data-surface="dark"
  data-hero
  class="relative isolate overflow-hidden bg-night"
>
  <!-- Background: survey-map contours, plus two soft light sources taken from the brand mark. -->
  <canvas data-contours class="absolute inset-0 -z-10 size-full" aria-hidden="true"></canvas>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-20 bg-[radial-gradient(60%_55%_at_72%_48%,rgb(20_152_155/0.28),transparent_70%),radial-gradient(40%_40%_at_10%_100%,rgb(31_111_178/0.3),transparent_70%),radial-gradient(30%_30%_at_95%_5%,rgb(244_166_42/0.12),transparent_70%)]"
  >
  </div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-t from-night to-transparent"></div>

  <div class="wrap grid min-h-[100svh] items-center gap-8 pb-10 pt-28 sm:pt-32 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.08fr)] lg:gap-6 lg:pb-16">
    <div class="relative z-10 max-w-[38rem]">
      <p
        class="inline-flex items-center gap-2.5 rounded-full border border-white/12 bg-white/5 py-1.5 pl-2.5 pr-4 text-sm font-medium text-slate-200 backdrop-blur [font-stretch:108%] motion-safe:animate-rise"
      >
        <span class="relative grid size-4 place-items-center" aria-hidden="true">
          <span class="absolute size-2 rounded-full bg-marigold-400 motion-safe:animate-pulse-ring"></span>
          <span class="size-2 rounded-full bg-marigold-400"></span>
        </span>
        Acadlas School is in development
      </p>

      <h1 id="hero-title" class="stretch-in mt-7">
        <span class="block" style="--d: 120ms">Your whole</span>{' '}
        <span class="block" style="--d: 260ms">school,</span>{' '}
        <span class="block text-marigold-400" style="--d: 400ms">connected.</span>
      </h1>

      <p class="lead mt-7 max-w-[32rem] text-slate-300 motion-safe:animate-rise [animation-delay:700ms]">
        Acadlas School is being designed to bring admissions, classes, attendance and fees into one place. Enter a
        student once, and their record follows them everywhere it's needed.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row motion-safe:animate-rise [animation-delay:850ms]">
        <a href="#how-it-works" class="btn btn-sun">
          See how it works
          <Icon name="arrow-down" size={18} />
        </a>
        <a href="#try" class="btn btn-ghost">Try the prototype</a>
      </div>
    </div>

    <!-- The record constellation. Every card is a button; dragging is an optional extra. -->
    <figure class="relative m-0 motion-safe:animate-rise [animation-delay:300ms]">
      <div
        data-orbit
        role="group"
        aria-label="Illustration with sample data: one student record connected to the student's guardian, class, attendance, fees and admission records."
        class="relative mx-auto aspect-[4/5] w-full max-w-[26rem] sm:aspect-[5/4] sm:max-w-none lg:aspect-auto lg:h-[min(40rem,74svh)]"
      >
        <svg data-orbit-links class="pointer-events-none absolute inset-0 size-full overflow-visible" aria-hidden="true"></svg>

        <!-- The student record. -->
        <div class="orbit-node z-[5]" data-node="center" data-x="0.5" data-y="0.47" data-mx="0.5" data-my="0.47" style="left: 50%; top: 47%; transform: translate(-50%, -50%)">
          <span aria-hidden="true" class="pointer-events-none absolute inset-0 rounded-[1.4rem] bg-marigold-400/35 opacity-0 motion-safe:animate-halo"></span>
          <button
            type="button"
            aria-expanded="false"
            class="orbit-card relative flex min-w-[13.5rem] flex-col rounded-[1.4rem] bg-white p-3 pr-5 text-left shadow-[0_30px_70px_-20px_rgb(0_0_0/0.7)] sm:min-w-[16rem] sm:p-3.5 sm:pr-6"
          >
            <span class="flex items-center gap-3">
              <span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-marigold-500 text-base font-extrabold text-night [font-stretch:115%] sm:size-12">AS</span>
              <span class="flex flex-col">
                <span class="text-[1.0625rem] font-bold leading-tight text-ink-800 [font-stretch:115%] sm:text-lg">Aarav Sharma</span>
                <span class="text-[0.8125rem] text-slate-600">Student, Class 6-B</span>
              </span>
            </span>
            <span class="orbit-detail">
              <span class="block">
                <span class="mt-3 grid grid-cols-2 gap-2 border-t border-slate-100 pt-3 text-[0.8125rem]">
                  <span class="flex flex-col"><span class="text-slate-600">Date of birth</span><span class="font-semibold text-ink-800">14 Jan 2015</span></span>
                  <span class="flex flex-col"><span class="text-slate-600">Linked records</span><span class="font-semibold text-ink-800">5</span></span>
                </span>
              </span>
            </span>
          </button>
        </div>

        {
          satellites.map((s) => (
            <div
              class="orbit-node z-[4]"
              data-node={s.key}
              data-x={s.x}
              data-y={s.y}
              data-mx={s.mx}
              data-my={s.my}
              data-depth={s.depth}
              data-values={JSON.stringify(s.values)}
              style={`left: ${s.x * 100}%; top: ${s.y * 100}%; transform: translate(-50%, -50%)`}
            >
              <button
                type="button"
                aria-expanded="false"
                class="orbit-card flex flex-col rounded-2xl border border-white/12 bg-ink-900/75 p-2 pr-3.5 text-left backdrop-blur-md hover:bg-ink-800/90 sm:p-2.5 sm:pr-4"
              >
                <span class="flex items-center gap-2.5">
                  <span class="grid size-8 shrink-0 place-items-center rounded-xl bg-lagoon-500/20 text-lagoon-300 sm:size-9">
                    <Icon name={s.icon} size={17} />
                  </span>
                  <span class="flex flex-col">
                    <span class="text-[0.6875rem] font-medium text-slate-400 [font-stretch:108%] sm:text-xs">{s.label}</span>
                    <span data-value class="whitespace-nowrap text-[0.8125rem] font-semibold text-white sm:text-sm" aria-live="off">
                      {s.values[0]}
                    </span>
                  </span>
                </span>
                <span class="orbit-detail">
                  <span class="block">
                    <span class="mt-2.5 flex flex-col gap-1.5 border-t border-white/10 pt-2.5 text-xs">
                      {s.detail.map(([k, v]) => (
                        <span class="flex justify-between gap-4">
                          <span class="text-slate-400">{k}</span>
                          <span class="font-semibold text-white">{v}</span>
                        </span>
                      ))}
                    </span>
                  </span>
                </span>
              </button>
            </div>
          ))
        }
      </div>

      <figcaption class="mt-4 flex items-center justify-center gap-2 text-sm text-slate-400 lg:mt-0">
        <Icon name="drag" size={16} class="text-lagoon-300" />
        <span>Drag any card, or tap one to open it. Illustration with sample data.</span>
      </figcaption>
    </figure>
  </div>

  <!-- What Acadlas School is being built to cover. -->
  <div class="relative border-t border-white/8">
    <div class="wrap py-5">
      <p class="sr-only">Acadlas School is being designed to cover:</p>
      <ul class="flex flex-wrap items-center justify-center gap-x-7 gap-y-3 text-[0.9375rem] text-slate-300 lg:justify-between">
        {
          scope.map((item) => (
            <li class="flex items-center gap-2">
              <Icon name={item.icon} size={17} class="text-lagoon-300" />
              {item.label}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  import { mountContours } from '../scripts/contours';
  import { mountConstellation } from '../scripts/constellation';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-contours]');
  const orbit = document.querySelector<HTMLElement>('[data-orbit]');

  if (hero && canvas) mountContours(canvas, hero);
  if (hero && orbit) mountConstellation(orbit, hero);
</script>
