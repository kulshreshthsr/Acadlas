---
import Icon from './Icon.astro';

const faqs = [
  {
    q: 'Can our school use Acadlas School today?',
    a: 'Yes. Create an account, set up your school, and you can admit or import students, run attendance registers, set fee plans and collect fees with numbered receipts. Online fee payment, a parent app, exams and report cards are not available yet.',
  },
  {
    q: 'What is the demo on this page?',
    a: 'A small illustration of admissions, attendance and fee recording on made-up sample data in your browser. Nothing you enter is saved. The real app is where your school’s records live.',
  },
  {
    q: 'Which schools is it for?',
    a: 'Schools that run classes and sections, terms, attendance registers and fee instalments. Fees are in rupees, receipts and certificates carry your school’s details, and students can be imported from a spreadsheet.',
  },
  {
    q: 'Will teachers be able to use it on their phones?',
    a: 'Yes. The app works in a phone browser, and teachers see only the classes they teach. It is not yet an installable app and does not work offline.',
  },
  {
    q: 'How are our school’s records kept private?',
    a: 'Each school’s data is kept separate: every request is tied to the signed-in school, and our tests try to open one school’s records from another and must fail. Permissions are checked on the server by role (owner, administrator, accountant, front office, teacher), and important changes are written to an audit trail. This has not had an independent security audit yet.',
  },
  {
    q: 'How much will it cost?',
    a: 'Pricing has not been announced. Ask us before you commit and we will tell you plainly what applies to your school.',
  },
];

// FAQ structured data for search engines; mirrors the visible questions exactly.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<section id="faq" aria-labelledby="faq-title" class="bg-paper pb-[clamp(4.5rem,2.5rem+6vw,8.5rem)]">
  <div class="wrap grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
    <div>
      <p class="kicker">FAQ</p>
      <h2 id="faq-title" class="mt-5 text-[clamp(1.75rem,1.2rem+2vw,2.75rem)]">Questions schools ask</h2>
    </div>
    <div class="flex flex-col gap-2.5">
      {
        faqs.map((f) => (
          <details class="faq group rounded-[var(--radius-lg)] bg-white shadow-soft ring-1 ring-slate-200 transition-shadow open:shadow-lift">
            <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-lg font-semibold text-ink-800 [font-stretch:110%] sm:px-6 [&::-webkit-details-marker]:hidden">
              {f.q}
              <span class="grid size-9 shrink-0 place-items-center rounded-full bg-slate-100 text-ink-800 transition-transform duration-300 group-open:rotate-45 group-open:bg-marigold-500">
                <Icon name="plus" size={18} />
              </span>
            </summary>
            <p class="max-w-[40rem] px-5 pb-6 text-[1.0625rem] leading-relaxed sm:px-6">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
