# Neon connection string (Dashboard → Connection details). Or, to run with no Neon at all,
# a local database folder: DATABASE_URL=pglite://.data/acadlas
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787

# Comma-separated list of frontend origins allowed to call this API with cookies.
CORS_ORIGINS=http://localhost:5173

# Where the browser app lives, for links in emails. Defaults to the first CORS origin.
# APP_URL=http://localhost:5173

# Production only. The app's Cloudflare proxy sends this with every request, and the API
# refuses requests without it — that is also how it knows each visitor's real address for
# rate limiting. Use the same value on the Pages project. Leave unset for local development.
# PROXY_SHARED_SECRET=

# Email. Leave unset and emails are printed in this terminal instead of sent; invitations
# also give you a link to copy or share on WhatsApp, so nothing depends on email.
# RESEND_API_KEY=
# MAIL_FROM=Acadlas <school@yourdomain.in>